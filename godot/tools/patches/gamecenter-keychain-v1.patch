+// The main bundle is the namespace; never use another game's access group.
+static NSMutableDictionary *flins_keychain_query(const String &p_key) {
+	if (!p_key.begins_with("golden_egg.") || p_key.length() > 128) {
+		return nil;
+	}
+	NSString *bundle = [[NSBundle mainBundle] bundleIdentifier];
+	NSString *account = [NSString stringWithUTF8String:p_key.utf8().get_data()];
+	if (bundle.length == 0 || account.length == 0) {
+		return nil;
+	}
+	return [@{
+		(__bridge id)kSecClass: (__bridge id)kSecClassGenericPassword,
+		(__bridge id)kSecAttrService: [bundle stringByAppendingString:@".golden-egg"],
+		(__bridge id)kSecAttrAccount: account,
+		(__bridge id)kSecAttrSynchronizable: @NO
+	} mutableCopy];
+}
+
+Dictionary GameCenter::flins_keychain_read(String p_key) {
+	Dictionary result;
+	result["ok"] = false;
+	result["found"] = false;
+	@autoreleasepool {
+		NSMutableDictionary *query = flins_keychain_query(p_key);
+		if (!query) {
+			result["status"] = (int)errSecParam;
+			return result;
+		}
+		query[(__bridge id)kSecReturnData] = @YES;
+		query[(__bridge id)kSecMatchLimit] = (__bridge id)kSecMatchLimitOne;
+		CFTypeRef item = NULL;
+		OSStatus status = SecItemCopyMatching((__bridge CFDictionaryRef)query, &item);
+		if (status == errSecSuccess && item && CFGetTypeID(item) == CFDataGetTypeID()) {
+			NSString *value = [[NSString alloc] initWithData:(__bridge NSData *)item encoding:NSUTF8StringEncoding];
+			if (value && value.length <= 8192) {
+				result["value"] = String([value UTF8String]);
+				result["ok"] = true;
+				result["found"] = true;
+			} else {
+				status = errSecDecode;
+			}
+		} else if (status == errSecItemNotFound) {
+			result["ok"] = true;
+		}
+		if (item) CFRelease(item);
+		result["status"] = (int)status;
+	}
+	return result;
+}
+
+int GameCenter::flins_keychain_write(String p_key, String p_value) {
+	@autoreleasepool {
+		NSMutableDictionary *query = flins_keychain_query(p_key);
+		if (!query || p_value.length() > 8192) return (int)errSecParam;
+		NSString *value = [NSString stringWithUTF8String:p_value.utf8().get_data()];
+		if (!value) return (int)errSecParam;
+		NSDictionary *attributes = @{
+			(__bridge id)kSecValueData: [value dataUsingEncoding:NSUTF8StringEncoding],
+			(__bridge id)kSecAttrAccessible: (__bridge id)kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+		};
+		OSStatus status = SecItemUpdate((__bridge CFDictionaryRef)query, (__bridge CFDictionaryRef)attributes);
+		if (status == errSecItemNotFound) {
+			[query addEntriesFromDictionary:attributes];
+			status = SecItemAdd((__bridge CFDictionaryRef)query, NULL);
+		}
+		return (int)status;
+	}
+}
+
+int GameCenter::flins_keychain_erase(String p_key) {
+	@autoreleasepool {
+		NSMutableDictionary *query = flins_keychain_query(p_key);
+		if (!query) return (int)errSecParam;
+		// Account AND app-owned service are always required: no bulk deletion.
+		OSStatus status = SecItemDelete((__bridge CFDictionaryRef)query);
+		return (status == errSecItemNotFound) ? (int)errSecSuccess : (int)status;
+	}
+}
